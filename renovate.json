{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 1,
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "commitMessagePrefix": "deps"
    },
    {
      "matchManagers": ["npm", "github-actions"],
      "groupName": "all dependencies"
    }
  ]
}