{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "Discord bot with TypeScript, running on Bun",
  "main": "src/main.ts",
  "scripts": {
    "start": "dotenvx run -- bun run src/main.ts",
    "dev": "dotenvx run -- bun --watch run src/main.ts",
    "deploy": "dotenvx run -- bun run src/deploy-commands.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "CloveTwilight3",
  "license": "MIT",
  "dependencies": {
    "@dotenvx/dotenvx": "^2.21.0",
    "axios": "^1.19.0",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
